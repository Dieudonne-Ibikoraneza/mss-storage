BACKEND_NETWORK=magnificat-backend
MINIO_ROOT_USER=magnificat-storage
# Generate with openssl rand -hex 32; copy to server MINIO_SECRET_KEY.
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=magnificat-smart-space
# Host ports only; the backend uses magnificat-minio:9000.
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
# Optional: public HTTPS console origin when reverse-proxied.
MINIO_BROWSER_REDIRECT_URL=
